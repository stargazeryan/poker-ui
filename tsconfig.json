{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "node"],
    "paths": {
      "@stargazeryan/poker-ui": ["./src/index.ts"]
    }
  },
  "include": ["src", "demo/src", "tests", "vitest.config.ts"]
}
