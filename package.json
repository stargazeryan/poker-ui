{
  "name": "@stargazeryan/poker-ui",
  "version": "0.6.0",
  "description": "Themable React + Tailwind CSS v4 components for poker tables and playing cards.",
  "license": "MIT",
  "author": "Ryan",
  "homepage": "https://stargazeryan.github.io/poker-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stargazeryan/poker-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumer": "node scripts/check-consumer.mjs",
    "docs": "vite --config demo/vite.config.ts",
    "docs:build": "npm run build && node scripts/build-docs.mjs dist",
    "demo": "npm run docs",
    "demo:build": "npm run docs:build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "check:release": "node scripts/check-release.mjs"
  },
  "keywords": [
    "poker",
    "playing-cards",
    "tailwindcss",
    "react",
    "component",
    "card",
    "table"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
