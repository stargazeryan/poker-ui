{
  "name": "@stargazeryan/poker-ui",
  "version": "0.1.0",
  "description": "Themable React + Tailwind CSS v4 components for poker tables and playing cards.",
  "license": "MIT",
  "author": "Ryan",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src/styles.css", "README.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "keywords": ["poker", "playing-cards", "tailwindcss", "react", "component", "card", "table"],
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
