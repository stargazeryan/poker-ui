{
  "name": "@stargazeryan/poker-ui",
  "version": "0.11.0",
  "description": "Game-agnostic React + Tailwind CSS v4 card-table UI: tables, seats, cards and chips.",
  "license": "MIT",
  "author": "Ryan",
  "homepage": "https://stargazeryan.github.io/poker-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stargazeryan/poker-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./wager": {
      "import": {
        "types": "./dist/wager.d.ts",
        "default": "./dist/wager.js"
      },
      "require": {
        "types": "./dist/wager.d.cts",
        "default": "./dist/wager.cjs"
      }
    },
    "./styles.css": "./src/styles.css",
    "./compiled.css": "./dist/compiled.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i scripts/compiled.css -o dist/compiled.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:consumer": "node scripts/check-consumer.mjs",
    "docs": "vite --config demo/vite.config.ts",
    "docs:build": "npm run build && node scripts/build-docs.mjs dist",
    "demo": "npm run docs",
    "demo:build": "npm run docs:build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "check:release": "node scripts/check-release.mjs"
  },
  "keywords": [
    "poker",
    "playing-cards",
    "tailwindcss",
    "react",
    "component",
    "card",
    "table"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "tailwind-merge": "^3.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
