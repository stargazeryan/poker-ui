# The mechanical half of a style: everyone's editor agrees on the things nobody
# should have to think about. Line breaking is *not* here — see eslint.config.js
# for why this repository has no formatter.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown keeps its hard line breaks: the docs are prose that wraps by hand.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
